DATABASE_URL=sqlite:///./leettrack.db
JWT_SECRET=change-me-to-a-long-random-string
DATA_RETENTION_DAYS=30
# NVIDIA (build.nvidia.com / NIM) API keys are managed via the Super
# Admin UI now (Settings -> AI Assistant), not here — see NvidiaApiKey
# in the database. You do NOT need an NVIDIA_API_KEY env var; that's
# the whole point of the DB-backed key management — the admin can
# add/rotate keys without a redeploy.
NVIDIA_MODEL=
ALLOWED_ORIGINS=["http://localhost:3000"]

# External API endpoints — overridable in case LeetCode/NVIDIA ever
# change their path, or you want to point at a proxy. Defaults are
# correct for normal use, no need to touch these.
NVIDIA_API_URL=
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql

# Bootstrap Super Admin — created automatically on first startup if no
# user with this username exists yet. CHANGE THESE before any real
# deployment — the committed defaults below are public (they're in this
# example file), so leaving them as-is means anyone who's seen this repo
# can log in as your Super Admin.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=

# Student self-registration is gated to this email domain — OTP confirms
# ownership. Super Admin can still create student accounts with any
# email from /admin, bypassing this.
STUDENT_EMAIL_DOMAIN=kit.ac.in
OTP_EXPIRE_MINUTES=10

# --- Email: Gmail API (preferred) -------------------------------------
# Sending as a specific Gmail address needs OAuth2. Run
# scripts/gmail_oauth_setup.py once, locally (not on the server) — it
# walks you through the Google Cloud Console setup, opens a browser to
# log into the sending account, and prints these four values.
# NEVER commit real values — this stays blank here on purpose.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Email: SMTP (fallback, only used if Gmail isn't configured) -------
# Leave SMTP_HOST blank too and OTP codes just get logged server-side
# and returned in the API response under `dev_otp` instead of actually
# emailed (see app/services/email.py) — fine for local dev, not for
# anything real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LeetTrack <no-reply@leettrack.local>
SMTP_USE_TLS=true
